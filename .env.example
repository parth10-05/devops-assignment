# Local defaults. Copy to .env and replace every value before a shared deployment.
POSTGRES_PASSWORD=change-me
GATEWAY_HTPASSWD=change-me
SMOKE_USER=smoke
SMOKE_PASSWORD=change-me

# Keep these values unset for local Docker Desktop. The EC2 deployment script
# supplies them from AWS Systems Manager Parameter Store.
# GATEWAY_BIND_ADDRESS=0.0.0.0
# GATEWAY_PORT=80
# ARTIFACTS_DIR=/opt/triageiq/artifacts
